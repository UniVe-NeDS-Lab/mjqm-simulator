#!/usr/bin/env bash

cd "$(dirname "$0")"

preset=default
clean=0
build=1
configure=1
setup_uv=1

for ARG in $(getopt -l clean,debug,build,help,no-build,only-build,no-uv -o 'cdbh' -- "$@"); do
    case "$ARG" in
        --clean|-c) clean=1 ; rm -rf build build-debug ;;
        --debug|-d) preset=debug ;;
        --build|-b) build=1 ;;
        --no-build) build=0 ;;
        --only-build) build=1 ; configure=0 ;;
        --help|-h) echo "Usage: $0 [--clean] [--debug] [--(|only-|no-)build] [--no-uv] [--help]"; exit 0 ;;
        --no-uv) setup_uv=0 ;;
        --) break;;
        *) echo "Unknown option: $ARG"; exit 1 ;;
    esac
done

CMAKE_VER=$(cmake --version | awk '/version/ {print $3}')

if [ ${configure} -eq 1 ]; then
    if [ ${setup_uv} -eq 1 ]; then
        # python environment with uv
        if [ -f "$HOME/.local/bin/env" ]; then
            source $HOME/.local/bin/env
        fi
        command -v uv || {
            curl -LsSf https://astral.sh/uv/install.sh | sh
            if [ -f "$HOME/.local/bin/env" ]; then
                source $HOME/.local/bin/env
            fi
        }
        uv sync --no-cache --link-mode=copy
    fi

    # configuration variabiles for cmake
    CXX=$(scripts/select-g++.sh)
    flags=("-DCMAKE_EXPORT_COMPILE_COMMANDS=YES" "-DCMAKE_CXX_COMPILER=${CXX}")
    if [ "$preset" == "debug" ]; then
        flags+=("-DCMAKE_BUILD_TYPE=Debug")
        folder=build-debug
    else
        flags+=("-DCMAKE_BUILD_TYPE=Release")
        folder=build
    fi ;

    # run cmake setup
    if [ ${CMAKE_VER} \< "3.19" ]; then
        ( set -x; cmake "${flags[@]}" -Wno-dev --fresh -S . -B $folder ; );
    else
        ( set -x; cmake --preset ${preset} "${flags[@]}" -Wno-dev --fresh .; );
    fi;
fi ;

if [ ${build} -eq 1 ]; then
    AVAILABLE_PROC=$(command -v nproc >/dev/null && nproc || sysctl -n hw.physicalcpu)
    flags=()
    targets=()
    if [ ${clean} -eq 1 ]; then
        flags+=(--clean-first)
        targets+=(clean all)
    fi ;

    if [ ${CMAKE_VER} \< "3.19" ]; then
        ( set -x; make -j ${AVAILABLE_PROC} -C $folder --no-print-directory "${targets[@]}" ; ) ;
    else
        ( set -x; cmake --build --preset ${preset} -j ${AVAILABLE_PROC} "${flags[@]}"; ) ;
    fi ;

fi
